# Plantilla del ambiente de DESARROLLO en la nube (Supabase "manifiesto-staging").
# Copiar a .env.dev y completar. Ver docs/operaciones/ambiente-dev.md
MANIFIESTO_ENV_LABEL=staging (nube)

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Dashboard → Settings → Database → Connection string (modo SESIÓN, puerto 5432).
# El pooler en modo transaction (6543) NO sirve para migraciones.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Tests de integración. Dashboard → Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
