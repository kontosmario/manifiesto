#!/usr/bin/env bash
# Pre-commit secret scanner.
#
# Scans the contents of files about to be committed for known
# secret patterns. Refuses the commit on a match.
#
# Why a hand-rolled scanner instead of gitleaks/git-secrets:
#   Both require a separate binary install (Go / brew). This is a
#   focused, dependency-free check covering the secrets this repo
#   actually handles: Supabase access tokens, service-role keys,
#   private keys, AWS-style access keys, and any commit that would
#   re-introduce the .env files we already gitignore.
#
# To enable in a fresh clone, run once:
#   git config core.hooksPath .githooks
#
# To bypass intentionally (rare, document why in commit message):
#   SKIP_SECRET_SCAN=1 SKIP_SECRET_SCAN_REASON="explaining why this is safe" \
#     git commit ...
#
# Sprint J · J-Infra3 — el bypass requiere una razón (>= 10 chars). Sin
# ella el hook falla cerrado. Cada uso se registra en
# `.git/skip-scans.log` (no se commitea: vive bajo `.git/`).

set -euo pipefail

if [ "${SKIP_SECRET_SCAN:-0}" = "1" ]; then
  REASON="${SKIP_SECRET_SCAN_REASON:-}"
  if [ "${#REASON}" -lt 10 ]; then
    echo "[pre-commit] BLOCKED: SKIP_SECRET_SCAN=1 requires SKIP_SECRET_SCAN_REASON with at least 10 characters."
    echo "  Usage: SKIP_SECRET_SCAN=1 SKIP_SECRET_SCAN_REASON='why this is safe' git commit ..."
    exit 1
  fi
  # Log to .git/skip-scans.log (local, not committed). `git rev-parse
  # --git-dir` works inside worktrees and submodules too.
  GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
  LOG_FILE="$GIT_DIR/skip-scans.log"
  TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  WHO="$(git config user.email 2>/dev/null || echo unknown)"
  BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
  printf '%s\t%s\t%s\treason=%s\n' "$TS" "$WHO" "$BRANCH" "$REASON" >> "$LOG_FILE"
  echo "[pre-commit] WARNING: secret scan skipped (logged to $LOG_FILE)"
  echo "  reason: $REASON"
  exit 0
fi

# Collect the list of staged files (Added/Copied/Modified/Renamed).
# Use a portable read loop instead of `mapfile` since macOS ships
# bash 3.2 by default.
STAGED_FILES=()
while IFS= read -r line; do
  STAGED_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#STAGED_FILES[@]}" -eq 0 ]; then
  exit 0
fi

# Files that must NEVER be committed even if .gitignore is bypassed.
FORBIDDEN_PATHS=(
  '^\.env$'
  '^\.env\.supabase$'
  '^\.env\.supabase\.[^.]+$'
  '^.*\.pem$'
  '^.*\.p12$'
  '^.*\.key$'
)

# Explicit allowlist for public-by-design crypto material that legitimately
# lives in the repo (Sprint F · F1: the EAS Update self-signed cert is
# bundled into the binary at build time so clients can verify OTA bundle
# signatures — see docs/operaciones/runbook-release-automation.md). The
# matching private key lives in keys/ (gitignored) + a GitHub Secret.
ALLOWED_PATHS=(
  '^certs/certificate\.pem$'
)

for f in "${STAGED_FILES[@]}"; do
  for pat in "${FORBIDDEN_PATHS[@]}"; do
    if [[ "$f" =~ $pat ]]; then
      # Allow .example placeholders.
      if [[ "$f" == *".example"* ]]; then
        continue
      fi
      # Allow explicit public-cert entries.
      allowed=0
      for ap in "${ALLOWED_PATHS[@]}"; do
        if [[ "$f" =~ $ap ]]; then
          allowed=1
          break
        fi
      done
      if [ "$allowed" -eq 1 ]; then
        continue
      fi
      echo "[pre-commit] BLOCKED: $f matches forbidden path pattern ($pat)"
      echo "  This file should never be committed. Verify .gitignore covers it."
      exit 1
    fi
  done
done

# Patterns matching real secret material. Tuned to this repo's stack
# (Supabase, AWS, generic JWTs, OpenSSH, AWS access keys).
SECRET_PATTERNS=(
  # Supabase Management API personal access token
  'sbp_[A-Za-z0-9_-]{30,}'
  # Supabase service-role JWT (HS256 + RS256 prefixes)
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+'
  # Anthropic API keys
  'sk-ant-[A-Za-z0-9_-]{30,}'
  # AWS access key id
  'AKIA[0-9A-Z]{16}'
  # AWS secret access key (rough heuristic)
  'aws_secret_access_key.*=.*[A-Za-z0-9/+=]{40}'
  # OpenSSH / PGP / RSA private key headers
  '-----BEGIN (RSA|OPENSSH|EC|PGP|DSA) PRIVATE KEY-----'
  # Sprint J · J-Infra4 — unqualified `-----BEGIN PRIVATE KEY-----`
  # (PKCS#8). ASC API `.p8` keys usan este header sin algoritmo
  # qualifier, así que el patrón anterior los dejaba pasar.
  '-----BEGIN PRIVATE KEY-----'
  # Bare service_role assignment
  'SUPABASE_SERVICE_ROLE_KEY[[:space:]]*=[[:space:]]*[A-Za-z0-9._-]+'
  # Postgres passwords inside connection strings
  'postgresql?://[^:]+:[^@/[:space:]]{8,}@'
)

violations=0

for f in "${STAGED_FILES[@]}"; do
  # Skip binaries, lockfiles, and the hook itself.
  #
  # Sprint Q · Audit #10 Q-7 (2026-06-10) — accepted trade-off:
  # `.githooks/*` is excluded because THIS very file embeds the
  # secret-pattern regexes as part of its logic (see SECRET_PATTERNS
  # array above). Scanning ourselves would always self-match and
  # never let any commit land that touches the hook. The trade-off
  # is that any *real* secret accidentally pasted into a future
  # `.githooks/*` file would slip past this scan — code review of
  # changes to `.githooks/*` is the compensating control.
  case "$f" in
    *.lock|*.png|*.jpg|*.jpeg|*.gif|*.pdf|*.zip|*.ipa|*.apk|.githooks/*)
      continue ;;
  esac

  if [ ! -f "$f" ]; then
    continue
  fi

  staged_content=$(git show ":$f" 2>/dev/null || true)
  if [ -z "$staged_content" ]; then
    continue
  fi

  for pat in "${SECRET_PATTERNS[@]}"; do
    if echo "$staged_content" | grep -E -q -- "$pat"; then
      echo "[pre-commit] SECRET DETECTED in $f"
      echo "  Pattern: $pat"
      echo "  Match (redacted): $(echo "$staged_content" | grep -E -o -- "$pat" | head -1 | cut -c1-12)…"
      violations=$((violations + 1))
    fi
  done
done

if [ "$violations" -gt 0 ]; then
  echo ""
  echo "[pre-commit] $violations secret pattern violation(s) found."
  echo "  - Move secrets to .env (already gitignored)."
  echo "  - Override the block ONLY if certain it's a false positive:"
  echo "      SKIP_SECRET_SCAN=1 SKIP_SECRET_SCAN_REASON='why' git commit ..."
  exit 1
fi

exit 0
