# Stack LOCAL de Supabase (Docker). Ver docs/operaciones/ambiente-dev.md
#
# __LAN_IP__ lo reemplaza scripts/env-runner.mjs por la IP de esta máquina en la
# red. Hace falta porque en Apple Silicon la app corre en un iPhone FÍSICO, y el
# device no resuelve 127.0.0.1 — tiene que llegar por la red local. La IP cambia
# según la red, así que no se puede fijar acá.
MANIFIESTO_ENV_LABEL=local (Docker)

EXPO_PUBLIC_SUPABASE_URL=http://__LAN_IP__:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
EXPO_PUBLIC_EAS_PROJECT_ID=

SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
