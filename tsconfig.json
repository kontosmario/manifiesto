{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "moduleSuffixes": [
      ".native",
      ".web",
      ""
    ],
    "paths": {
      "@/*": [
        "./mobile/*"
      ]
    }
  },
  "include": [
    "app/**/*",
    "mobile/**/*",
    "app.config.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
