{
  "name": "manifiesto",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "patch-package",
    "lint": "eslint app mobile --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/env-runner.mjs .env.dev vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "node scripts/env-runner.mjs .env.dev vitest --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run guard:legacy-spacing && npm run guard:forbidden-copy && npm run guard:motion-tokens && npm run guard:font-scale && npm run guard:i18n-keys && npm run guard:i18n-quality && npm run guard:i18n-hardcoded",
    "guard:legacy-spacing": "if grep -rn 'legacySpacing' mobile app --include='*.ts' --include='*.tsx'; then echo 'Found legacySpacing references — these must be migrated to the new 4-base spacing scale.'; exit 1; else exit 0; fi",
    "guard:forbidden-copy": "node scripts/guard-forbidden-copy.mjs",
    "guard:motion-tokens": "node scripts/guard-motion-tokens.mjs",
    "guard:font-scale": "node scripts/guard-font-scale.mjs",
    "guard:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "guard:i18n-quality": "node scripts/check-i18n-quality.mjs",
    "guard:i18n-hardcoded": "node scripts/check-i18n-hardcoded.mjs",
    "dev:start": "node scripts/env-runner.mjs .env.dev expo start -c",
    "dev:ios": "node scripts/env-runner.mjs .env.dev expo run:ios --device",
    "dev:android": "node scripts/env-runner.mjs .env.dev expo run:android --device",
    "local:start": "node scripts/env-runner.mjs .env.localdb expo start -c",
    "local:ios": "node scripts/env-runner.mjs .env.localdb expo run:ios --device",
    "db:local:up": "supabase start",
    "db:local:down": "supabase stop",
    "db:local:reset": "supabase db reset",
    "db:local:studio": "open http://127.0.0.1:54323",
    "db:staging:push": "node scripts/env-runner.mjs .env.dev supabase db push --db-url '${SUPABASE_DB_URL}'",
    "db:staging:diff": "node scripts/env-runner.mjs .env.dev supabase db diff --db-url '${SUPABASE_DB_URL}'",
    "db:seed:staging": "node scripts/env-runner.mjs .env.dev node scripts/db-seed.mjs",
    "functions:staging:deploy": "node scripts/env-runner.mjs .env.dev supabase functions deploy --project-ref '${SUPABASE_PROJECT_REF}'",
    "supabase:remote": "node scripts/supabase-remote.mjs",
    "supabase:remote:login": "node scripts/supabase-remote.mjs login",
    "supabase:remote:link": "node scripts/supabase-remote.mjs link",
    "supabase:remote:db:push": "node scripts/supabase-remote.mjs db push",
    "supabase:functions:check": "node scripts/check-edge-functions-deployed.mjs",
    "supabase:remote:functions:deploy": "node scripts/check-edge-functions-deployed.mjs && node scripts/supabase-remote.mjs functions deploy",
    "supabase:remote:functions:deploy:one": "node scripts/supabase-remote.mjs functions deploy",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:push": "supabase db push",
    "supabase:db:pull": "supabase db pull",
    "supabase:functions:serve": "supabase functions serve",
    "supabase:functions:deploy": "node scripts/check-edge-functions-deployed.mjs && supabase functions deploy",
    "test:integration:prod": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.10",
    "@hcaptcha/react-native-hcaptcha": "^4.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/query-async-storage-persister": "^5.100.6",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.100.6",
    "expo": "~54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-iap": "^4.3.1",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "~5.1.1",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.3.3",
    "js-sha256": "^0.11.1",
    "prop-types": "^15.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-confetti-cannon": "1.5.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.1.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "sharp": "^0.34.5",
    "supabase": "^2.92.1",
    "svgo": "^4.0.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  }
}
