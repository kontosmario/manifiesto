# Claude Code local agent config (skills, settings, session state) — local to
# each machine, not shared via git.
.claude/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Scratch / one-off SQL artifacts. Anything dropped under tmp/ is
# treated as throwaway by tooling and conversation context — keep it
# out of git so it can't accidentally ship PII or credentials.
tmp/

# Per-conversation scratch dropped at repo root by tooling.
.tmp_*

# Source archives don't belong in version control. The repo's source
# is the source; tarballs / zips invariably end up stale and bloat
# clones.
*.zip
backups/

# Supabase CLI temp files
supabase/.temp/

# EAS Update code signing — private key never leaves the owner's machine
# (and the CI runner that consumes it via GitHub Secret EXPO_UPDATE_PRIVATE_KEY).
# The public cert in certs/certificate.pem IS committed: it gets bundled
# into the binary so the client can verify update signatures.
# See docs/operaciones/runbook-release-automation.md → "EAS Update code signing".
keys/
