# Scratch / one-off SQL artifacts. Anything dropped under tmp/ is
# treated as throwaway by tooling and conversation context — keep it
# out of git so it can't accidentally ship PII or credentials.
tmp/

# Source archives don't belong in version control. The repo's source
# is the source; tarballs / zips invariably end up stale and bloat
# clones.
*.zip
backups/

# Supabase CLI temp files
supabase/.temp/
